# ====================================================================
# MINER CLC - Configuración por Entorno (Anexo A)
# Duplicar este archivo como .env para personalizar variables locales
# ====================================================================

# ENTORNO ACTIVO: development | staging | production
APP_ENV=development
APP_NAME=MINER_CLC
APP_VERSION=1.0.0+1

# BASE DE DATOS POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=miner_clc
DB_USER=postgres
DB_PASSWORD=minercl c123
DB_SSL=false
DB_TIMEOUT_SECONDS=8

# AUTENTICACIÓN GOOGLE REAL (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=miner-clc-app.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
GOOGLE_VERIFY_REAL_ACCOUNTS=true

# LOGGING Y AUDITORÍA (Anexo A)
LOG_LEVEL=DEBUG
LOG_FILE_PATH=miner_clc.log
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5
LOG_DATABASE_AUDIT=true

# RESPALDO DE DATOS (Anexo A)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_AUTO_SCHEDULE_CRON="0 2 * * *" # Diario a las 02:00 AM

# ====================================================================
# CHATBOT IA (backend RAG + LLM en /api, desplegado en Vercel)
# Estas variables se configuran en Vercel > Settings > Environment Variables.
# NUNCA las pongas en el código Flutter ni subas la clave a GitHub.
# ====================================================================
LLM_PROVIDER=gemini                 # gemini | openai (openai sirve también para Ollama/Groq vía OPENAI_BASE_URL)
GEMINI_API_KEY=                     # Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-2.5-flash       # Cambia el modelo sin tocar código
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini
RAG_MIN_SCORE=0.8                   # Umbral de relevancia; por debajo se responde "fuera de dominio" sin gastar LLM
RATE_LIMIT_PER_MIN=20
ALLOWED_ORIGIN=*                    # En producción, el dominio de tu app
